{
  "name": "@easy-vite/plugin-html",
  "version": "5.0.0",
  "description": "A Vite plugin to minify index.html, render it with EJS templates, inject entries, and support MPA — compatible with Vite 5-8",
  "keywords": [
    "ejs",
    "html",
    "minify",
    "mpa",
    "multi-page",
    "template",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/easy-vite/plugin-html/tree/master/#readme",
  "bugs": {
    "url": "https://github.com/easy-vite/plugin-html/issues"
  },
  "license": "MIT",
  "author": "@easy-vite",
  "repository": {
    "type": "git",
    "url": "https://github.com/easy-vite/plugin-html",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "README.zh_CN.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && cp ../../README.md ./README.md && cp ../../README.zh_CN.md ./README.zh_CN.md && cp ../../CHANGELOG.md ./CHANGELOG.md"
  },
  "dependencies": {
    "connect-history-api-fallback": "^2.0.0",
    "ejs": "^6.0.1",
    "html-minifier-terser": "^7.2.0",
    "node-html-parser": "^9.0.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
